# Copy this file to .env and fill in real values before running the server.
#
# RUNNING VIA DOCKER COMPOSE (see docker-compose.yml's `env_file:`)? Compose
# interpolates $VAR / ${VAR} inside env_file values, same as it does inside
# docker-compose.yml itself. A bcrypt hash below is FULL of literal dollar
# signs ($2b$12$...), so Compose will try to treat pieces of it as variable
# references, find them undefined, and silently blank them out — truncating
# your hash and breaking admin login with no error at startup (it only
# surfaces later, as a 500 on login). Escape every literal $ as $$ in the
# .env file Docker Compose actually reads, e.g.:
#   ADMIN_PASSWORD_HASH=$$2b$$12$$abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQ
# This does NOT apply when running the backend directly (uvicorn/venv,
# no Docker) — that path reads .env literally via python-dotenv, so leave
# $ unescaped there. Since .env is git-ignored and never shared between a
# local dev machine and a server anyway, this is a per-environment concern.

# Admin login — used only to seed the admin_account table on first run.
# After that, the password (and notification email) are managed from the
# admin panel's Account tab, not by editing this file.
ADMIN_USERNAME=admin
# Generate a hash with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
ADMIN_PASSWORD_HASH=

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# SQLite database file (relative to backend/)
DATABASE_URL=sqlite:///./persepolis.db

# Comma-separated list of origins allowed to call the API (your frontend URL(s))
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Used to build the link inside password-reset emails
FRONTEND_URL=http://127.0.0.1:5500

# SMTP — leave blank to disable email sending (nothing breaks, emails are just
# skipped). Fill in with a real provider to enable password-reset and
# new-quote/new-review notification emails. Example for Gmail: host
# smtp.gmail.com, port 587, username your address, password an "app password"
# (not your normal Gmail password — generate one at myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
